# =============================================
# Predictive Healthcare System — Environment
# =============================================

# Backend
DATABASE_URL=sqlite:///./phs.db
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS
FRONTEND_URL=http://localhost:5173

# Admin seed
ADMIN_EMAIL=admin@phs.local
ADMIN_PASSWORD=Admin@12345

# ML
ML_ARTIFACTS_DIR=../ml/artifacts
MODEL_REGISTRY_PATH=../ml/artifacts/registry.json

# Frontend (Vite uses VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Predictive Healthcare System
# Optional: VITE_MAPBOX_TOKEN=your_mapbox_token_here
